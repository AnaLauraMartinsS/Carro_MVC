<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Lista de Veículos</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background-color: #2c3e50;
            color: #ecf0f1;
        }
        .navbar {
            background-color: #34495e;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .navbar a {
            color: #ecf0f1;
            text-decoration: none;
            padding: 10px 20px;
            font-size: 1.1em;
            transition: background-color 0.3s, color 0.3s;
        }
        .navbar a:hover {
            background-color: #2980b9;
            color: white;
            border-radius: 5px;
        }
        .container {
            max-width: 900px;
            margin: 50px auto;
            background-color: #34495e;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }
        h1 {
            color: #9b59b6;
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #555;
        }
        th {
            background-color: #2c3e50;
            color: #ecf0f1;
            font-weight: bold;
        }
        tr:hover {
            background-color: #4a6279;
        }
        .actions {
            display: flex;
            gap: 10px;
            flex-wrap: nowrap;
        }
        .actions button {
            padding: 8px 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            color: white;
            white-space: nowrap;
        }
        .actions .edit { background-color: #9b59b6; }
        .actions .delete { background-color: #c0392b; }
        .footer {
            background-color: #34495e;
            color: #ecf0f1;
            text-align: center;
            padding: 20px;
            position: fixed;
            bottom: 0;
            width: 100%;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.2);
        }
        form.edit-form {
            display: flex;
            gap: 5px;
            align-items: center;
        }
        form.edit-form input {
            background: #ecf0f1;
            color: #2c3e50;
            border: 1px solid #7f8c8d;
            border-radius: 4px;
            padding: 5px;
        }
    </style>
</head>
<body>
    <div class="navbar">
        <a href="/">Home</a>
        <a href="/cadastro">Cadastrar Veículo</a>
        <a href="/veiculos">Lista de Veículos</a>
    </div>

    <div class="container">
        <h1>Lista de Veículos</h1>
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Fabricante</th>
                    <th>Lançamento</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% veiculos.forEach(function(veiculo) { %>
                    <tr>
                        <td><%= veiculo.nome %></td>
                        <td><%= veiculo.fabricante %></td>
                        <td><%= veiculo.data %></td>
                        <td>
                            <div class="actions">
                                <form action="/veiculos/editar/<%= veiculo.id %>" method="POST" class="edit-form">
                                    <input type="text" name="nome" placeholder="Novo nome" required>
                                    <button type="submit" class="edit">Editar</button>
                                </form>
                                <form action="/veiculos/excluir/<%= veiculo.id %>" method="POST">
                                    <button type="submit" class="delete">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <div class="footer">
        <p>Ana Laura Martins - MVC Carros &copy; 2025</p>
    </div>
</body>
</html>